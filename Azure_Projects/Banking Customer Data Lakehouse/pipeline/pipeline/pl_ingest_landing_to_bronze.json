											"type": "Expression"
										}
									}
								}
							]
						},
						{
							"name": "Copy data to Dedicated SQL Pool",
							"type": "Copy",
							"dependsOn": [
								{
									"activity": "Copy_Landing_To_Bronze",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"source": {
									"type": "ParquetSource",
									"storeSettings": {
										"type": "AzureBlobFSReadSettings",
										"recursive": true,
										"wildcardFolderPath": {
											"value": "@item().SourceFolderName",
											"type": "Expression"
										},
