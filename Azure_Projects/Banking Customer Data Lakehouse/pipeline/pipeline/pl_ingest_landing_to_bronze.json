										"p_file_name": "*.parquet"
									}
								}
							],
							"outputs": [
								{
									"referenceName": "ds_sqlpool_gold_dynamic",
									"type": "DatasetReference",
									"parameters": {
										"p_table_name": {
											"value": "@item().TargetTableName",
											"type": "Expression"
										}
									}
								}
							]
						}
					]
				}
			}
		],
