				],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@json('[\n  {\"FolderName\": \"Customer_Master\", \"TargetTableName\": \"DimCustomer\"},\n  {\"FolderName\": \"Account_Master\", \"TargetTableName\": \"DimAccount\"},\n  {\"FolderName\": \"Loan_Details\", \"TargetTableName\": \"FactLoan\"},\n  {\"FolderName\": \"Transaction_Logs\", \"TargetTableName\": \"Fact_Transactions\"}\n]')",
						"type": "Expression"
					},
					"isSequential": false,
					"activities": [
						{
							"name": "Copy_Silver_To_Synapse_DW",
							"type": "Copy",
							"dependsOn": [],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"source": {
									"type": "ParquetSource",
									"storeSettings": {
										"type": "AzureBlobFSReadSettings",
										"recursive": true,
										"enablePartitionDiscovery": false
									},
									"formatSettings": {
										"type": "ParquetReadSettings"
									}
								},
								"sink": {
									"type": "SqlDWSink",
									"preCopyScript": {
										"value": "@concat('TRUNCATE TABLE dbo.', item().TargetTableName)",
										"type": "Expression"
									},
									"allowCopyCommand": true,
									"disableMetricsCollection": false
								},
								"enableStaging": false
							},
							"inputs": [
								{
									"referenceName": "ds_adls_silver_parquet",
									"type": "DatasetReference",
									"parameters": {
										"p_container_name": "silver",
										"p_folder_name": {
											"value": "@item().FolderName",
											"type": "Expression"
										},
										"p_file_name": {
											"value": "@item()",
											"type": "Expression"
										}
									}
								}
							],
							"outputs": [
								{
									"referenceName": "ds_sqlpool_gold_dynamic",
									"type": "DatasetReference",
									"parameters": {
										"p_table_name": {
											"value": "@item().TargetTableName",
											"type": "Expression"
										}
									}
								}
							]
						}
					]
				}
